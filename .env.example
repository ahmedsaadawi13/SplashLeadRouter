# SplashLeadRouter Environment Configuration
# Copy this file to .env and update with your actual values

# Application
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost

# Database
DB_HOST=localhost
DB_NAME=splashleadrouter
DB_USER=root
DB_PASS=

# Email (optional - for future SMTP integration)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@splashleadrouter.com
MAIL_FROM_NAME=SplashLeadRouter

# Security
SESSION_LIFETIME=7200
