# SplashLeadRouter - Git Ignore

# Environment files
.env

# Storage and uploads
/storage/uploads/*
!/storage/uploads/.gitkeep
/storage/*.txt
/storage/*.log

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*~

# IDE Files
.idea/
.vscode/
*.swp
*.swo
*.swn
*.bak

# Composer
/vendor/
composer.lock

# Node modules (if you add frontend build tools later)
node_modules/
package-lock.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Cache
*.cache
